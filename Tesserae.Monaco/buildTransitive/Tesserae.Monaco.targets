<Project>
  <!--
    Shipped inside the Tesserae.Monaco NuGet package and auto-imported by referencing projects
    (buildTransitive/, so transitive consumers get it too). On build it copies the pre-built Monaco
    distribution into the Transpose output folder, next to the compiled app, where the components
    load it from at runtime (assets/js/monaco).

    Monaco is copied rather than embedded as a Transpose resource on purpose - see the note in
    tps.json. In short: Transpose emits a <script> tag for each ".js" resource and renames them into
    ".min.js" variants, and Monaco must be loaded on demand under a name its own bundle expects, so
    neither is survivable.

    The same file serves both consumption models. A package consumer resolves the payload at
    ../monaco inside the restored package. Inside this repo there is no such folder, so it falls
    back to Tesserae.Monaco/assets/js/monaco - the (gitignored) esbuild output. That lets
    Tesserae.Monaco.Sample import this file directly and exercise exactly the copy a real consumer
    gets.
  -->
  <PropertyGroup>
    <_MonacoPackagedDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'monaco'))</_MonacoPackagedDir>
    <_MonacoRepoBundleDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'assets', 'js', 'monaco'))</_MonacoRepoBundleDir>
  </PropertyGroup>

  <!--
    Runs after Build so it lands after the Transpose compiler has written (and possibly cleaned) the
    output folder. SkipUnchangedFiles keeps the ~14 MB bundle off the critical path on rebuilds.

    Everything is resolved inside the target rather than in a top-level PropertyGroup, because
    MSBuild evaluates those at import time - before any target has run. That would break two ways:
    $(OutDir) is still empty then, so the copy would land somewhere wrong; and on a fresh clone the
    repo bundle does not exist yet (the referenced project's BundleMonaco target creates it later in
    the same build), so the Exists() check would fail and the build would report Monaco missing even
    though it is about to appear.
  -->
  <Target Name="_CopyMonacoAssets"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">

    <PropertyGroup>
      <_MonacoSourceDir Condition="Exists('$(_MonacoPackagedDir)')">$(_MonacoPackagedDir)</_MonacoSourceDir>
      <_MonacoSourceDir Condition="'$(_MonacoSourceDir)' == '' and Exists('$(_MonacoRepoBundleDir)')">$(_MonacoRepoBundleDir)</_MonacoSourceDir>

      <MonacoAssetsOutputDir Condition="'$(MonacoAssetsOutputDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'tps', 'assets', 'js', 'monaco'))</MonacoAssetsOutputDir>
    </PropertyGroup>

    <Error Condition="'$(_MonacoSourceDir)' == ''"
           Text="Tesserae.Monaco: no Monaco distribution found. Looked in '$(_MonacoPackagedDir)' (package) and '$(_MonacoRepoBundleDir)' (repo). If building this repo from source, run 'npm install &amp;&amp; npm run bundle' in the Tesserae.Monaco folder." />

    <ItemGroup>
      <_MonacoFiles Include="$(_MonacoSourceDir)**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(_MonacoFiles)"
          DestinationFiles="@(_MonacoFiles->'$(MonacoAssetsOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />

    <Message Importance="normal"
             Text="Tesserae.Monaco: copied Monaco from $(_MonacoSourceDir) to $(MonacoAssetsOutputDir)" />
  </Target>
</Project>
