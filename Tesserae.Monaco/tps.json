{
    // Always build both minified and non-minified versions of the code so that resources for both versions are always included in the binary and so referencing projects can decide whether
    // to use the minified versions or the non-minified versions
    "outputFormatting": "Both",
    "resources": [
        // Include the JS that is compiled from the C# in this project - be sure to include non-minified AND minified version (and to include the meta data files required for reflection)
        // because Transpose will only include ".min.js" versions of resources when a project that references this is built in Release and will only include NON-".min.js" versions when built
        // in Debug (this is the default behaviour for projects that don't have any external resources to build into the binary but when a "resources" section is present in a tps.json
        // file then that default behaviour is lost and must be opted back into).
        {
            "name": "Tesserae.Monaco.js",
            "files": [
                "$(OutDir)tps/Tesserae.Monaco.js"
            ]
        },
        {
            "name": "Tesserae.Monaco.meta.js",
            "files": [
                "$(OutDir)tps/Tesserae.Monaco.meta.js"
            ]
        },
        {
            "name": "Tesserae.Monaco.min.js",
            "files": [
                "$(OutDir)tps/Tesserae.Monaco.min.js"
            ]
        },
        {
            "name": "Tesserae.Monaco.meta.min.js",
            "files": [
                "$(OutDir)tps/Tesserae.Monaco.meta.min.js"
            ]
        }
        // NOTE: the Monaco distribution itself is deliberately NOT a Transpose resource. It is
        // packed into the NuGet package under monaco/ and copied into the consuming project's
        // output by buildTransitive/Tesserae.Monaco.targets instead. Three reasons:
        //   - Transpose emits a <script> tag for every ".js" resource, but the entry is an ES module
        //     a classic <script> cannot evaluate at all, and its chunks and the workers are fetched
        //     on demand; injecting them eagerly both breaks them and costs megabytes on first paint.
        //   - "outputFormatting": "Both" renames resources into ".min.js" variants, and the chunk
        //     names are baked into the entry's import statements - a renamed chunk is a 404.
        //   - The "files" globs are single-level, so Monaco's nested tree (100 files, chunks/
        //     included) cannot be expressed without one entry per folder.
    ],
    "cleanOutputFolderBeforeBuildPattern": "*.*",
    "loader": {
        "type": "Global"
    },
    "generateTypeScript": false,
    "generateDocumentation": "None",
    "rules": {
        "anonymousType": "Plain",
        "arrayIndex": "Managed",
        "autoProperty": "Plain",
        "boxing": "Managed",
        "externalCast": "Plain",
        "inlineComment": "Plain",
        "integer": "Managed",
        "lambda": "Plain",
        "useShortForms": true
    },
    "sourceMap": {
        "enabled": false
    }
}
