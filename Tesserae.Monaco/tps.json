{
    // A package ships every variant of its compiled output and the consumer picks one: the readable
    // bundle (Debug site), the minified bundle (Release site), and - because of "outputBy": "Module" -
    // an ES module entry plus its chunks (Release site with "outputBy": "Module", which is how every
    // Curiosity front-end and the Tesserae it runs on are built). Without this the package carries
    // only the classic bundles, and a chunked Release app evaluates them against a Tesserae that lives
    // in ES modules - a combination nothing verifies. Nothing else needs declaring for it: the
    // compiler embeds all the variants itself (listing the project's own Tesserae.Monaco.js here is
    // the Bridge-era spelling and now contributes only a load flag), and a Debug consumer still gets
    // one readable bundle, since a Debug site is never chunked.
    "outputBy": "Module",
    // The Monaco distribution (monaco.js, its chunks, the workers, the codicon font) is a resource, and
    // a copy-through one: no name ending in .js, so nothing is concatenated or renamed, and "load":
    // false, so no <script> is injected - the entry is an ES module a classic <script> cannot evaluate,
    // and its chunks and workers are fetched on demand. "**" keeps the folder structure, which
    // matters: esbuild named the chunks and wrote their paths into the entry's imports, so a file that
    // moves or is renamed is a 404. Every file ships under the name esbuild gave it.
    //
    // It used to be left out of tps.json and copied by an MSBuild target in buildTransitive/, which
    // works only for a build that runs MSBuild. A build that does not - the in-process compiler behind a
    // Curiosity workspace's own front-end - shipped a site with no Monaco at all, and every code editor
    // answered a 404 for assets/js/monaco/monaco.js. A resource is carried by the compiler itself, so
    // every way of building a site gets it. The folder is generated (BundleMonaco, gitignored).
    "resources": [
        {
            "name": "monaco",
            "files": [ "assets/js/monaco/**" ],
            "output": "assets/js/monaco/",
            "load": false
        }
    ],
    "cleanOutputFolderBeforeBuildPattern": "*.*",
    "loader": {
        "type": "Global"
    },
    "generateTypeScript": false,
    "generateDocumentation": "None",
    "rules": {
        "anonymousType": "Plain",
        "arrayIndex": "Managed",
        "autoProperty": "Plain",
        "boxing": "Managed",
        "externalCast": "Plain",
        "inlineComment": "Plain",
        "integer": "Managed",
        "lambda": "Plain",
        "useShortForms": true
    },
    "sourceMap": {
        "enabled": false
    }
}
