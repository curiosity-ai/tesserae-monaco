{
    // A package ships every variant of its compiled output and the consumer picks one: the readable
    // bundle (Debug site), the minified bundle (Release site), and - because of "outputBy": "Module" -
    // an ES module entry plus its chunks (Release site with "outputBy": "Module", which is how every
    // Curiosity front-end and the Tesserae it runs on are built). Without this the package carries
    // only the classic bundles, and a chunked Release app evaluates them against a Tesserae that lives
    // in ES modules - a combination nothing verifies. Nothing else needs declaring for it: the
    // compiler embeds all the variants itself (listing the project's own Tesserae.Monaco.js here is
    // the Bridge-era spelling and now contributes only a load flag), and a Debug consumer still gets
    // one readable bundle, since a Debug site is never chunked.
    "outputBy": "Module",
    // NOTE: the Monaco distribution itself is deliberately NOT a Transpose resource. It is packed
    // into the NuGet package under monaco/ and copied into the consuming project's output by
    // buildTransitive/Tesserae.Monaco.targets instead. Three reasons:
    //   - Transpose emits a <script> tag for every ".js" resource, but the entry is an ES module a
    //     classic <script> cannot evaluate at all, and its chunks and the workers are fetched on
    //     demand; injecting them eagerly both breaks them and costs megabytes on first paint.
    //   - A ".js" resource is paired with a ".min.js" variant by name, and the chunk names are baked
    //     into the entry's import statements - a renamed chunk is a 404.
    //   - Monaco's tree is esbuild's output, not this compiler's: its chunks are named and linked by
    //     esbuild, so they cannot ride along as Transpose module chunks either.
    "cleanOutputFolderBeforeBuildPattern": "*.*",
    "loader": {
        "type": "Global"
    },
    "generateTypeScript": false,
    "generateDocumentation": "None",
    "rules": {
        "anonymousType": "Plain",
        "arrayIndex": "Managed",
        "autoProperty": "Plain",
        "boxing": "Managed",
        "externalCast": "Plain",
        "inlineComment": "Plain",
        "integer": "Managed",
        "lambda": "Plain",
        "useShortForms": true
    },
    "sourceMap": {
        "enabled": false
    }
}
